# Reference data
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reference_service
DB_USER=
DB_PASSWORD=

# Sessions (auth DB)
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=authorization_service
AUTH_DB_USER=
AUTH_DB_PASSWORD=

# Object settings templates and settings
SUPPLY_DB_HOST=localhost
SUPPLY_DB_PORT=3306
SUPPLY_DB_NAME=supply_service
SUPPLY_DB_USER=
SUPPLY_DB_PASSWORD=

# Checko API (проверка контрагентов)
CHECKO_API_KEY=

# При настройке TENANTS имена трёх баз обязательны для каждого сайта.
# Без TENANTS используются DB_NAME, AUTH_DB_NAME и SUPPLY_DB_NAME выше.
# TENANTS=FIRST,EFIMOV
# TENANT_FIRST_HOSTS=sso.st29.ru,supply.st29.ru,metal.st29.ru,timetrack.st29.ru,permission.st29.ru,salary.st29.ru
# TENANT_FIRST_SESSION_COOKIE=session
# TENANT_FIRST_DB_NAME=authorization_service
# TENANT_FIRST_REFERENCE_DB_NAME=reference_service
# TENANT_FIRST_SUPPLY_DB_NAME=supply_service
# TENANT_EFIMOV_HOSTS=efimov.st29.ru
# TENANT_EFIMOV_SESSION_COOKIE=session_efimov
# TENANT_EFIMOV_DB_NAME=authorization_service_efimov
# TENANT_EFIMOV_REFERENCE_DB_NAME=reference_service_efimov
# TENANT_EFIMOV_SUPPLY_DB_NAME=supply_service_efimov
